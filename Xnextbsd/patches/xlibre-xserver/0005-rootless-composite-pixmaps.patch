Description: rootless: leave Composite's window pixmaps alone.
 To draw into a top-level window, rootless points the window at its
 frame's pixmap, and back at the screen's when it stops. It did that
 even when Composite had redirected the window and given it a pixmap of
 its own, and when Composite unredirects a window it frees whatever
 pixmap the window has. With the frame's in its place, that freed the
 frame's pixmap (a glamor pixmap with 0002), and the next drawing into
 the frame used it: Xnextbsd segfaulted in damagePolyFillRect and
 damageCopyArea when Chromium's screen-share picker unredirected the
 windows it had redirected for its thumbnails. Point only windows that
 draw into the screen's pixmap at the frame's (here and for
 ParentRelative ancestors), and on stopping, restore only windows that
 still have the frame's, including ones that took it from a parent.
Origin: NextBSD
 (E38 nextbsd/nextbsd#642)
Forwarded: not-needed (NextBSD only, for now)
---
--- a/miext/rootless/rootlessCommon.c
+++ b/miext/rootless/rootlessCommon.c
@@ -222,6 +222,16 @@
         RL_DEBUG_MSG("Window %p already has winRec->pixmap %p; not pushing\n",
                      pWindow, winRec->pixmap);
     }
+    else if (curPixmap != pScreen->GetScreenPixmap(pScreen)) {
+        /*
+         * A pixmap of its own: Composite redirected the window (or an
+         * ancestor). It draws there, not into the frame, and Composite
+         * frees whatever pixmap the window has when it unredirects it;
+         * with the frame's in its place, that freed the frame's pixmap.
+         */
+        RL_DEBUG_MSG("Window %p has a pixmap of its own %p; not pushing\n",
+                     pWindow, curPixmap);
+    }
     else {
         PixmapPtr oldPixmap =
             dixLookupPrivate(&pWindow->devPrivates,
@@ -260,21 +270,21 @@
         dixLookupPrivate(&pWindow->devPrivates,
                          rootlessWindowOldPixmapPrivateKey);
     if (oldPixmap == NULL) {
+        /* It took the frame's pixmap from its parent while drawing
+           (Composite unredirected it): back to the screen's. */
         if (exPixmap == winRec->pixmap)
-            RL_DEBUG_MSG
-                ("Window %p appears to be in drawing mode (ex-pixmap %p equals winRec->pixmap, which is being freed) but has no oldPixmap!\n",
-                 pWindow, exPixmap);
+            pScreen->SetWindowPixmap(pWindow,
+                                     pScreen->GetScreenPixmap(pScreen));
     }
     else {
-        if (exPixmap != winRec->pixmap)
+        /* Only if it still has the frame's: Composite may have given it
+           a pixmap of its own since, which isn't ours to replace. */
+        if (exPixmap == winRec->pixmap)
+            pScreen->SetWindowPixmap(pWindow, oldPixmap);
+        else
             RL_DEBUG_MSG
-                ("Window %p appears to be in drawing mode (oldPixmap %p) but ex-pixmap %p not winRec->pixmap %p!\n",
-                 pWindow, oldPixmap, exPixmap, winRec->pixmap);
-        if (oldPixmap == winRec->pixmap)
-            RL_DEBUG_MSG
-                ("Window %p's oldPixmap %p is winRec->pixmap, which has just been freed!\n",
-                 pWindow, oldPixmap);
-        pScreen->SetWindowPixmap(pWindow, oldPixmap);
+                ("Window %p has pixmap %p, not winRec->pixmap %p; keeping it\n",
+                 pWindow, exPixmap, winRec->pixmap);
         dixSetPrivate(&pWindow->devPrivates, rootlessWindowOldPixmapPrivateKey,
                       NULL);
     }
--- a/miext/rootless/rootlessWindow.c
+++ b/miext/rootless/rootlessWindow.c
@@ -1306,6 +1306,9 @@
         }
 
         pWin = pWin->parent;
-        pScreen->SetWindowPixmap(pWin, topWinRec->pixmap);
+        /* not over a pixmap of its own (Composite's): see
+           RootlessStartDrawing */
+        if (pScreen->GetWindowPixmap(pWin) == pScreen->GetScreenPixmap(pScreen))
+            pScreen->SetWindowPixmap(pWin, topWinRec->pixmap);
     }
 }
